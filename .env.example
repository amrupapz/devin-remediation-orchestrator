# Set DRY_RUN=true to run the full pipeline with simulated Devin/GitHub calls.
DRY_RUN=true

# Devin v3 API. DEVIN_API_KEY must be a service-user key (prefix `cog_`) and
# DEVIN_ORG_ID the organization that owns the sessions (prefix `org-`).
DEVIN_API_KEY=
DEVIN_ORG_ID=
# Hard ceiling on ACUs per remediation session.
MAX_ACU_PER_SESSION=10

# Fine-grained GitHub token with issues:write and pull_requests:read on the fork.
GITHUB_TOKEN=

GITHUB_REPO=amrupapz/superset
BASE_BRANCH=master
TRIGGER_LABEL=devin-ready

POLL_INTERVAL=30
MAX_CONCURRENT=3
HOURS_SAVED_PER_ISSUE=2

# Optional: shared secret for GitHub webhook signature verification.
WEBHOOK_SECRET=
