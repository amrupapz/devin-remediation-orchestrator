# Set DRY_RUN=true to run the full pipeline with simulated Devin/GitHub calls.
DRY_RUN=true

DEVIN_API_KEY=
DEVIN_ORG_ID=
DEVIN_MAX_ACU=5
GITHUB_TOKEN=

GITHUB_REPO=amrupapz/superset
BASE_BRANCH=master
TRIGGER_LABEL=devin-ready

POLL_INTERVAL=30
MAX_CONCURRENT=3
HOURS_SAVED_PER_ISSUE=2

# Required for the webhook when DRY_RUN=false. The poller works without it.
WEBHOOK_SECRET=
